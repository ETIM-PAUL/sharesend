# Copy to .env and fill in. Never commit .env.

# --- Binance Web3 API (key created with "B402 Payments" permission ticked) ---
# Auth: X-OC-APIKEY, X-OC-TIMESTAMP (ISO 8601), X-OC-SIGN = base64(HMAC-SHA256(ts + METHOD + path + body)); path includes /build
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://web3.binance.com/build
# B402 production network; testnet (eip155:97) is QA only
B402_NETWORK=eip155:56

# --- Gift vault (B402 payTo; pays out claims, returns, refunds). Agent service only. ---
VAULT_ADDRESS=
VAULT_PRIVATE_KEY=

# --- Agentic Wallet (baw CLI); address from `baw wallet address` ---
AGENTIC_WALLET_ADDRESS=

# --- Database ---
DATABASE_URL=

# --- Safety and caps (enforced in code) ---
LIVE_TRADING=false
MAX_GIFT_USD=20
DAILY_CAP_USD=50
SERVICE_FEE_USD=0.10
QUOTE_TTL_SECONDS=60
GIFT_EXPIRY_DAYS=30
WEEKEND_WARN_PCT=1.0
MAX_PRICE_IMPACT_PCT=1.5
MAX_QUOTE_DRIFT_PCT=1.0
KEEPALIVE_MINUTES=60
