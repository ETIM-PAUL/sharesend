# --- Binance Web3 API (create at https://web3.binance.com/en/dev-portal/project, desktop browser) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Safety ---
# Trader only simulates unless this is exactly "true". Never flip without explicit approval.
LIVE_TRADING=false
# Per-trade cap in USD, enforced in code
MAX_TRADE_USD=5

# --- Receipt signing (server). Generate a fresh key; never reuse a funded one. ---
RECEIPT_SIGNER_PRIVATE_KEY=

# --- x402 / B402 payments (BSC testnet, chain 97) ---
TESTNET_PRIVATE_KEY=
TESTNET_PAY_TO_ADDRESS=
B402_FACILITATOR_URL=
B402_API_KEY=

# --- Mainnet demo wallet (Agentic Wallet; see docs/dx-log.md for setup status) ---
MAINNET_DEMO_ADDRESS=
