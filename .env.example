# Copy to .env and fill in. Never commit .env.

# --- Binance Web3 API (key created with "B402 Payments" permission ticked) ---
# Auth: X-OC-APIKEY, X-OC-TIMESTAMP (ISO 8601), X-OC-SIGN = base64(HMAC-SHA256(ts + METHOD + path + body)); path includes /build
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://web3.binance.com/build
# B402 production network; testnet (eip155:97) is QA only
B402_NETWORK=eip155:56

# --- Gift vault (B402 payTo; pays out claims, returns, refunds). Agent service only. ---
VAULT_ADDRESS=
VAULT_PRIVATE_KEY=

# --- Agentic Wallet (baw CLI); address from `baw wallet address` ---
AGENTIC_WALLET_ADDRESS=

# --- Web ---
# Base URL for claim links (the web app). Defaults to the agent service's own URL.
CLAIM_BASE_URL=
# Browser origins allowed to call this service (comma-separated), e.g. the Vercel URL.
WEB_ORIGINS=http://localhost:3000
# Start the buy as soon as a payment settles. Only on a host where `baw` is signed in; otherwise gifts wait as "queued".
AUTO_EXECUTE=false

# --- Agent identity and operations (Phase 10) ---
# ERC-8004 identity owner. Holds no funds (registration is gas-sponsored); not the vault key.
IDENTITY_PRIVATE_KEY=
IDENTITY_ADDRESS=
# This service's public URL (published in the agent's on-chain profile).
AGENT_PUBLIC_URL=https://sharesend-agent-production.up.railway.app
# Bearer token for /admin routes (Agentic Wallet sign-in, run a job). 24+ random characters.
ADMIN_TOKEN=
# Optional: alerts (signed out, session ending, holdings short) are POSTed here as {"text": ...}.
ALERT_WEBHOOK_URL=
# Mainnet ERC-8004 identity, so a fresh database still shows it on /agent (read back from the registry).
ERC8004_AGENT_ID=
ERC8004_REGISTER_TX=
# Constant key input for the `baw` CLI's saved session (otherwise derived from the MAC address, which changes on every
# redeploy and signs the wallet out). Generate once with `openssl rand -hex 16`; never change it. Keep it private.
BINANCE_INSTANCE_ID=
# Chat ("Tell the agent"): without a key the chat box is hidden and the form is the only way to send.
# OpenAI keys start with sk-; Anthropic keys with sk-ant-. If both are set, OpenAI is used unless CHAT_PROVIDER=anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-6-luna          (defaults: gpt-6-luna for OpenAI, claude-haiku-4-5-20251001 for Anthropic)
# CHAT_DAILY_LIMIT=400
# JOBS=off disables the autonomous jobs on this instance.
JOBS=on

# --- Database ---
DATABASE_URL=
# DB tests only: they drop and recreate schemas test_ledger and test_execution. Never point this at real data.
TEST_DATABASE_URL=

# --- Chain ---
# Public BSC RPC for reading vault balances (reconciliation).
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Safety and caps (enforced in code) ---
LIVE_TRADING=false
MAX_GIFT_USD=20
DAILY_CAP_USD=50
SERVICE_FEE_USD=0.10
QUOTE_TTL_SECONDS=60
GIFT_EXPIRY_DAYS=30
WEEKEND_WARN_PCT=1.0
MAX_PRICE_IMPACT_PCT=1.5
MAX_QUOTE_DRIFT_PCT=1.0
# Slippage passed to `baw market-order swap` (percent).
MAX_SLIPPAGE_PCT=1.0
KEEPALIVE_MINUTES=60
